<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-passport-table" author="Eugene">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="passport"/>
            </not>
        </preConditions>
        <createTable tableName="passport">
            <column name="passport_id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="series" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="number" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="issue_branch" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="issue_date" type="DATE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet author="Eugene" id="create-employment-table">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="employment"/>
            </not>
        </preConditions>
        <createTable tableName="employment">
            <column name="employment_id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="status" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="employer_inn" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
            <column name="salary" type="decimal(15,2)">
                <constraints nullable="true"/>
            </column>
            <column name="position" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
            <column name="work_experience_total" type="int">
                <constraints nullable="true"/>
            </column>
            <column name="work_experience_current" type="int">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="create-client-table" author="Eugene">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="client"/>
            </not>
        </preConditions>
        <createTable tableName="client">
            <column name="client_id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="last_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="first_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="middle_name" type="VARCHAR(255)"/>
            <column name="birth_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)"/>
            <column name="gender" type="VARCHAR(50)"/>
            <column name="marital_status" type="VARCHAR(50)"/>
            <column name="dependent_amount" type="INTEGER"/>
            <column name="passport_id" type="UUID"/>
            <column name="employment_id" type="UUID"/>
            <column name="account_number" type="VARCHAR(50)"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="client"
                                 baseColumnNames="passport_id"
                                 referencedTableName="passport"
                                 referencedColumnNames="passport_id"
                                 constraintName="fk_client_passport"/>
        <addForeignKeyConstraint baseTableName="client"
                                 baseColumnNames="employment_id"
                                 referencedTableName="employment"
                                 referencedColumnNames="employment_id"
                                 constraintName="fk_client_employment"/>
    </changeSet>
</databaseChangeLog>
